<section class="price-list">
    <div class="container">
        {{ breadcrumbs(
            items=[
                { title: "Главная", url: "/home.html" },
                { title: "Цены" }
            ],
            separator="line",
            size="sm"
        ) }}

        <h1 class="price-title" data-aos="fade-right">Прайс-лист на ремонт электродвигателей (цены без НДС)</h1>

        <div class="table-wrap" data-aos="fade-up">
            <table class="price-table">
                <thead>
                    <tr>
                        <th class="col-power" rowspan="3">Мощность, кВт</th>
                        <th class="head-freq" colspan="4">Частота вращение, обороты/мин.</th>
                        <th class="head-terms" colspan="2">Сроки выполнения ремонта (в рабочих днях)</th>
                    </tr>
                    <tr>
                        <th>3 000</th>
                        <th>1 500</th>
                        <th>1 000</th>
                        <th>750</th>
                        <th class="term" rowspan="2">Плановый</th>
                        <th class="term" rowspan="2">Срочный (наценка 30%)</th>
                    </tr>
                    <tr>
                        <th class="sub">Цена (без НДС)</th>
                        <th class="sub">Цена (без НДС)</th>
                        <th class="sub">Цена (без НДС)</th>
                        <th class="sub">Цена (без НДС)</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in priceRows %}
                        <tr>
                            <th class="col-power" scope="row">{{ row[0] }}</th>
                            <td>от {{ row[1] }}</td>
                            <td>от {{ row[2] }}</td>
                            <td>от {{ row[3] }}</td>
                            <td>от {{ row[4] }}</td>
                            <td>от {{ row[5] }}</td>
                            <td>от {{ row[6] }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <p class="note">* Все цены указаны в рублях без НДС</p>

        <h2 class="coeff-title" data-aos="fade-right">Коэффициенты повышения цены перемотки электродвигателей</h2>

        <div class="table-wrap" data-aos="fade-up">
            <table class="coeff-table">
                <tbody>
                    {% for row in coeffRows %}
                        <tr>
                            <td class="name">{{ row[0] }}</td>
                            <td class="coef">{{ row[1] }}</td>
                            <td class="name">{{ row[2] }}</td>
                            <td class="coef">{{ row[3] }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="includes">
            <article class="inc-card blue" data-aos="fade-up">
                <h3 class="inc-head">Ремонт общепромышленных электродвигателей включает в себя:</h3>
                <ol class="inc-list">
                    {% for item in repairIncludes %}
                        <li>{{ loop.index }}. {{ item }}</li>
                    {% endfor %}
                </ol>
            </article>

            <article class="inc-card orange" data-aos="fade-up" data-aos-delay="100">
                <h3 class="inc-head">Профилактический ремонт общепромышленных электродвигателей включает в себя:</h3>
                <ol class="inc-list">
                    {% for item in preventiveIncludes %}
                        <li>{{ loop.index }}. {{ item }}</li>
                    {% endfor %}
                </ol>
            </article>
        </div>
    </div>
</section>