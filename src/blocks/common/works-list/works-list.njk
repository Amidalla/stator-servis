{% from "components/general/breadcrumbs/breadcrumbs.njk" import render as breadcrumbs %}
{% from "components/general/tabs/tabs.njk" import render as tabs %}
{% from "components/general/slider-nav/slider-nav.njk" import navBtn, mobileNav %}

{# Навигация галереи внутри карточки (стрелки поверх фото) — как в блоке «Наши работы» на главной #}
{% macro gallery_nav() %}
    <div class="gallery-nav">
        <button class="nav-btn prev" type="button" aria-label="Предыдущее фото">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="58"
                height="63"
                viewBox="0 0 58 63"
                fill="none"
                aria-hidden="true"
            >
                <path class="nav-bg" d="M0 0H58V63H0V0Z" fill="white" />
                <path
                    class="nav-arrow"
                    d="M39.7071 32.2071C40.0976 31.8166 40.0976 31.1834 39.7071 30.7929L33.3431 24.4289C32.9526 24.0384 32.3195 24.0384 31.9289 24.4289C31.5384 24.8195 31.5384 25.4526 31.9289 25.8431L37.5858 31.5L31.9289 37.1569C31.5384 37.5474 31.5384 38.1805 31.9289 38.5711C32.3195 38.9616 32.9526 38.9616 33.3431 38.5711L39.7071 32.2071ZM19 31.5V32.5H39V31.5V30.5H19V31.5Z"
                    fill="#D64212"
                />
            </svg>
        </button>
        <button class="nav-btn next" type="button" aria-label="Следующее фото">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="58"
                height="63"
                viewBox="0 0 58 63"
                fill="none"
                aria-hidden="true"
            >
                <path class="nav-bg" d="M0 0H58V63H0V0Z" fill="white" />
                <path
                    class="nav-arrow"
                    d="M39.7071 32.2071C40.0976 31.8166 40.0976 31.1834 39.7071 30.7929L33.3431 24.4289C32.9526 24.0384 32.3195 24.0384 31.9289 24.4289C31.5384 24.8195 31.5384 25.4526 31.9289 25.8431L37.5858 31.5L31.9289 37.1569C31.5384 37.5474 31.5384 38.1805 31.9289 38.5711C32.3195 38.9616 32.9526 38.9616 33.3431 38.5711L39.7071 32.2071ZM19 31.5V32.5H39V31.5V30.5H19V31.5Z"
                    fill="#D64212"
                />
            </svg>
        </button>
    </div>
{% endmacro %}

{# Карточка работы. Переиспользует разметку карточек блока «Наши работы» (our-works). #}
{% macro workCard(work) %}
    <article class="card">
        <a class="card-link" href="/nashi-raboty/peremotka-alternatora/" aria-label="{{ work.name }}"></a>
        <div class="media">
            <div class="gallery swiper">
                <div class="swiper-wrapper">
                    {% for image in work.images %}
                        <div class="swiper-slide">
                            <img
                                class="lazy"
                                src="{{ image }}"
                                data-src="{{ image }}"
                                alt="{{ work.name }}"
                                width="416"
                                height="405"
                            />
                        </div>
                    {% endfor %}
                </div>
                <span class="tag">{{ work.tag }}</span>
                {{ gallery_nav() }}
            </div>
        </div>
        <div class="info">
            <h3 class="name">{{ work.name }}</h3>
            <p class="model">Модель: <span>{{ work.model }}</span></p>
            <ul class="specs">
                {% for spec in work.specs %}
                    <li>
                        <span class="key">{{ spec.key }}:</span>
                        <span class="val">{{ spec.val }}</span>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </article>
{% endmacro %}

{% set pumpWork = {
    tag: "Диагностика насосов",
    name: "Произведена разборка и диагностика насосов",
    model: "GRINDEX и FLYGT",
    images: ["/assets/images/content/our-works-pumps.png", "/assets/images/content/our-works-motor.png"],
    specs: [
        { key: "Мощность", val: "20/18 кВт" },
        { key: "кВт", val: "2900" },
        { key: "Об/мин", val: "23/20" }
    ]
} %}

{% set motorWork = {
    tag: "Замена обмоток статора электродвигателя",
    name: "Замена обмоток статора, сборка и испытание, электродвигателя",
    model: "TEE",
    images: ["/assets/images/content/our-works-motor.png", "/assets/images/content/our-works-pumps.png"],
    specs: [
        { key: "кВт", val: "37" },
        { key: "Об/мин", val: "1500" }
    ]
} %}

{% set works = [pumpWork, motorWork] %}

{# Вкладки-фильтры. count — сколько карточек показать, pagination — нужна ли пагинация #}
{% set worksTabs = [
    { id: "nasosy", title: "Насосы", active: true, count: 12, pagination: true },
    { id: "electro", title: "Электродвигатели", count: 6, pagination: false },
    { id: "benzo", title: "Бензогенераторы", count: 2, pagination: false },
    { id: "alter", title: "Альтернаторы", count: 2, pagination: false }
] %}

<section class="works-list" data-works-list>
    <div class="container">
        {{ breadcrumbs(
            items=[
                { title: "Главная", url: "/home.html" },
                { title: "Наши работы" }
            ],
            separator="line",
            size="sm"
        ) }}

        <h1 class="works-list-title" data-aos="fade-right">Наши работы</h1>

        {{ tabs(
            items=worksTabs,
            group="works",
            class="works-list-tabs",
            ariaLabel="Категории работ"
        ) }}

        <div class="works-panels" data-tabs-panels="works">
            {% for tab in worksTabs %}
                <div
                    class="works-panel{% if tab.active %} active{% endif %}"
                    id="panel-works-{{ tab.id }}"
                    role="tabpanel"
                    aria-labelledby="tab-works-{{ tab.id }}"
                    data-tab-panel="{{ tab.id }}"
                    data-tabs-group="works"
                    {% if not tab.active %}hidden{% endif %}
                >
                    <div class="our-works">
                        <div class="grid" data-aos="fade-up" data-aos-delay="200">
                            {% for i in range(0, tab.count) %}
                                {{ workCard(works[i % (works | length)]) }}
                            {% endfor %}
                        </div>
                    </div>

                    {% if tab.pagination %}
                        {#
                            Пагинация в стиле слайдеров — заглушки под WordPress (paginate_links()).
                        #}
                        <nav class="works-pagination" aria-label="Навигация по страницам">
                            <div class="controls">
                                {{ navBtn(direction="prev", label="Предыдущая страница", disabled=true) }}
                                <div class="pagination">
                                    <a class="bullet active" href="?page=1" aria-current="page" aria-label="Страница 1"></a>
                                    <a class="bullet" href="?page=2" aria-label="Страница 2"></a>
                                    <a class="bullet" href="?page=3" aria-label="Страница 3"></a>
                                    <a class="bullet" href="?page=4" aria-label="Страница 4"></a>
                                    <a class="bullet" href="?page=5" aria-label="Страница 5"></a>
                                </div>
                                {{ navBtn(direction="next", label="Следующая страница", href="?page=2") }}
                            </div>
                            {{ mobileNav(
                                prevLabel="Предыдущая страница",
                                nextLabel="Следующая страница",
                                fraction="1/5",
                                prevDisabled=true,
                                nextHref="?page=2"
                            ) }}
                        </nav>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
</section>