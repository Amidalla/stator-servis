{% from "components/common/service-tags/service-tags.njk" import render as serviceTags %}

<section class="directions" data-directions>
    <div class="container">
        <div class="intro" data-aos="fade-up">
            <h2 class="title">Статор-Сервис</h2>
            <p class="text">
                Собственное производство, все работы мы проводим сами, без посредников, с гарантией качества и успевая
                точно в срок!
            </p>
        </div>

        <div class="cards">
            <article class="card" data-aos="fade-up" data-aos-delay="100">
                <div class="visual">
                    <div class="image">
                        <img
                            class="lazy"
                            src="/assets/images/content/directions-repair.png"
                            data-src="/assets/images/content/directions-repair.png"
                            alt="Ремонт промышленного оборудования"
                            width="528"
                            height="213"
                        />
                    </div>
                    <img
                        class="watermark"
                        src="/assets/images/content/stator-watermark.svg"
                        alt=""
                        width="527"
                        height="108"
                        aria-hidden="true"
                    />
                </div>
                <h3 class="name">Ремонт</h3>
                <p class="caption">промышленного оборудования</p>
                {{ serviceTags(tags=["Электродвигатели", "Насосы", "Бензогенераторы", "Вентиляторы"]) }}
            </article>

            <article class="card" data-aos="fade-up" data-aos-delay="200">
                <div class="visual">
                    <div class="image">
                        <img
                            class="lazy"
                            src="/assets/images/content/directions-rewind.png"
                            data-src="/assets/images/content/directions-rewind.png"
                            alt="Перемотка промышленного оборудования"
                            width="528"
                            height="213"
                        />
                    </div>
                    <img
                        class="watermark"
                        src="/assets/images/content/stator-watermark.svg"
                        alt=""
                        width="527"
                        height="108"
                        aria-hidden="true"
                    />
                </div>
                <h3 class="name">Перемотка</h3>
                <p class="caption">промышленного оборудования</p>
                {{ serviceTags(tags=["Электродвигатели", "Альтернаторы", "Бензогенераторы", "Трансформаторы", "Катушки"]) }}
            </article>

            <article class="card" data-aos="fade-up" data-aos-delay="300">
                <div class="visual">
                    <div class="image">
                        <img
                            class="lazy"
                            src="/assets/images/content/directions-balance.png"
                            data-src="/assets/images/content/directions-balance.png"
                            alt="Балансировка промышленного оборудования"
                            width="528"
                            height="213"
                        />
                    </div>
                    <img
                        class="watermark"
                        src="/assets/images/content/stator-watermark.svg"
                        alt=""
                        width="527"
                        height="108"
                        aria-hidden="true"
                    />
                </div>
                <h3 class="name">Балансировка</h3>
                <p class="caption">промышленного оборудования</p>
                {{ serviceTags(tags=["Роторы", "Якоря", "Муфты", "Промышленные вентиляторы"]) }}
            </article>
        </div>
    </div>
</section>