{% from "components/common/service-tags/service-tags.njk" import render as serviceTags %}

<section class="service-other">
    <div class="container">
        <h2 class="title" data-aos="fade-up">Другие наши услуги</h2>

        <div class="cards">
            <article class="card" data-aos="fade-up" data-aos-delay="100">
                <div class="visual">
                    <div class="image">
                        <img
                            class="lazy"
                            src="/assets/images/content/service-other-rewind.png"
                            data-src="/assets/images/content/service-other-rewind.png"
                            alt="Перемотка промышленного оборудования"
                            width="812"
                            height="212"
                        />
                    </div>
                    <span class="watermark" aria-hidden="true">статор</span>
                </div>
                <h3 class="name">Перемотка</h3>
                <p class="caption">промышленного оборудования</p>
                {{ serviceTags(tags=["Электродвигатели", "Альтернаторы", "Бензогенераторы", "Трансформаторы", "Катушки"]) }}
            </article>

            <article class="card" data-aos="fade-up" data-aos-delay="200">
                <div class="visual">
                    <div class="image">
                        <img
                            class="lazy"
                            src="/assets/images/content/service-other-balance.png"
                            data-src="/assets/images/content/service-other-balance.png"
                            alt="Балансировка промышленного оборудования"
                            width="812"
                            height="212"
                        />
                    </div>
                    <span class="watermark" aria-hidden="true">статор</span>
                </div>
                <h3 class="name">Балансировка</h3>
                <p class="caption">промышленного оборудования</p>
                {{ serviceTags(tags=["Роторы", "Якоря", "Муфты", "Промышленные вентиляторы"]) }}
            </article>
        </div>
    </div>
</section>