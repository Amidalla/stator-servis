{% from "components/general/breadcrumbs/breadcrumbs.njk" import render as breadcrumbs %}
{% from "components/general/slider-nav/slider-nav.njk" import navBtn, mobileNav %}

{% set query = "Ремонт электродвигателей" %}
{% set total = 24 %}

{# Демо-результат (повторяется; на WP — тело цикла по выдаче) #}
{% set result = {
    title: "Ремонт асинхронных электродвигателей",
    href: "/service-detail/",
    text: "Ремонт асинхронных Когда долго работаешь с электродвигателями и трансформаторным оборудованием, быстро понимаешь: электромагнитная катушка — деталь маленькая, но ключевая. От её состояния зависит, будет ли устройство работать стабильно или внезапно «встанет» в самый неподходящий момент."
} %}

{% macro arrow() %}
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
        <path
            d="M1 7H17M11.5 1.5L17 7L11.5 12.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
        />
    </svg>
{% endmacro %}

<section class="search-results">
    <div class="container">
        {{ breadcrumbs(
            items=[
                { title: "Главная", url: "/home.html" },
                { title: "Результаты поиска" }
            ],
            separator="line",
            size="sm"
        ) }}

        <div class="head" data-aos="fade-right">
            <h1 class="search-title">По запросу <span>«{{ query }}»</span></h1>
            <p class="search-count">найдено {{ total }} совпадения</p>
        </div>

        <form class="search-field" action="/poisk/" method="get" role="search" data-aos="fade-up">
            <span class="ic" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="21" height="22" viewBox="0 0 21 22" fill="none">
                    <path
                        d="M8.96582 1C13.3646 1 16.9324 4.56839 16.9326 8.97168C16.9326 13.3751 13.3647 16.9443 8.96582 16.9443C4.56702 16.9442 1 13.375 1 8.97168C1.00018 4.56848 4.56713 1.00014 8.96582 1Z"
                        stroke="currentColor"
                        stroke-width="2"
                    />
                    <path
                        d="M14.9219 15.4688L14.1679 16.1255L18.8169 21.4627L19.5709 20.8059L20.3249 20.1491L15.6759 14.812L14.9219 15.4688Z"
                        fill="currentColor"
                    />
                </svg>
            </span>
            <input
                type="text"
                name="q"
                value="{{ query }}"
                placeholder="Поиск по сайту"
                autocomplete="off"
                aria-label="Поисковый запрос"
            />
            <button class="clear" type="reset" aria-label="Очистить">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 20 20"
                    fill="none"
                    aria-hidden="true"
                >
                    <path d="M5 5L15 15M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
            </button>
        </form>

        <div class="results" data-aos="fade-up" data-aos-delay="100">
            {% for i in range(0, 12) %}
                <article class="result">
                    <div class="body">
                        <h2 class="name"><a href="{{ result.href }}">{{ result.title }}</a></h2>
                        <p class="text">{{ result.text }}</p>
                    </div>
                    <a class="go" href="{{ result.href }}" aria-label="Открыть: {{ result.title }}">
                        {{ arrow() }}
                    </a>
                </article>
            {% endfor %}
        </div>

        {#
            Пагинация в стиле слайдеров — заглушки под WordPress (paginate_links()).
        #}
        <nav class="search-pagination" aria-label="Навигация по страницам">
            <div class="controls">
                {{ navBtn(direction="prev", label="Предыдущая страница", disabled=true) }}
                <div class="pagination">
                    <a class="bullet active" href="?page=1" aria-current="page" aria-label="Страница 1"></a>
                    <a class="bullet" href="?page=2" aria-label="Страница 2"></a>
                </div>
                {{ navBtn(direction="next", label="Следующая страница", href="?page=2") }}
            </div>
            {{ mobileNav(
                prevLabel="Предыдущая страница",
                nextLabel="Следующая страница",
                fraction="1/2",
                prevDisabled=true,
                nextHref="?page=2"
            ) }}
        </nav>
    </div>
</section>