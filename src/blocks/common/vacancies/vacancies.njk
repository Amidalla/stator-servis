<section class="vacancies">
    <div class="container">
        {{ breadcrumbs(
            items=[
                { title: "Главная", url: "/home.html" },
                { title: "Вакансии" }
            ],
            separator="line",
            size="sm"
        ) }}

        <h1 class="vacancies-title" data-aos="fade-right">Вакансии</h1>
        <p class="vacancies-lead" data-aos="fade-right">
            Присоединяйтесь к команде «Статор-Сервис». Мы ремонтируем промышленное оборудование и всегда рады
            специалистам, которые любят своё дело.
        </p>

        <div class="layout">
            <div class="vacancies-main">
                <div class="accordion vacancies-list" data-accordion="component" data-aos="fade-up">
                    {% for vac in vacancies %}
                        <div class="item{% if loop.first %} is-open{% endif %}" data-accordion-item>
                            <button
                                type="button"
                                class="panel"
                                aria-expanded="{% if loop.first %}true{% else %}false{% endif %}"
                                aria-controls="vacancy-{{ loop.index }}"
                            >
                                <span class="head">
                                    <span class="name">{{ vac.title }}</span>
                                    <span class="address">
                                        {{ pinIcon | safe }}
                                        <span>{{ vac.address }}</span>
                                    </span>
                                </span>
                                <span class="price">от <b>{{ vac.price }}</b></span>
                            </button>
                            <div class="collapse" id="vacancy-{{ loop.index }}" role="region">
                                <div class="wrap">
                                    {% for group in vac.groups %}
                                        <div class="vacancy-group">
                                            <h2>{{ group.title }}</h2>
                                            <ul>
                                                {% for item in group.items %}
                                                    <li>{{ item }}</li>
                                                {% endfor %}
                                            </ul>
                                        </div>
                                    {% endfor %}

                                    <div class="vacancy-cta">
                                        {% if vac.note %}
                                            <span class="vacancy-note">
                                                {{ pinIcon | safe }}
                                                <span>{{ vac.note }}</span>
                                            </span>
                                        {% endif %}
                                        {{ button(
                                            text="Откликнуться",
                                            type="button",
                                            variant="red",
                                            class="vacancy-btn",
                                            data={"src": "popup-callback", "vacancy": vac.title}
                                        ) }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <aside class="sidebar">
                {% include "components/common/consult-sidebar/consult-sidebar.njk" %}
            </aside>
        </div>
    </div>
</section>