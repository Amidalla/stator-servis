{% from "components/general/breadcrumbs/breadcrumbs.njk" import render as breadcrumbs %}
{% from "components/general/tabs/tabs.njk" import render as tabs %}

{# Вопросы-ответы. Переиспользуют аккордеон (data-accordion) и содержимое faq-home. #}
{% set faqItems = [
    {
        q: "Сколько стоит перемотка электродвигателя?",
        a: "Стоимость зависит от мощности, типа обмотки и состояния железа. После диагностики согласуем смету и сроки — без скрытых доплат."
    },
    {
        q: "Сколько времени занимает перемотка?",
        a: "В среднем от нескольких рабочих дней до двух недель — в зависимости от сложности, наличия материалов и загрузки мастерской. Срочный ремонт обсуждаем отдельно."
    },
    {
        q: "Где можно найти специалистов по перемотке электродвигателей?",
        a: "Специализированные ремонтные мастерские, занимающиеся ремонтом электрооборудования, могут выполнить перемотку электродвигателей. Также можно найти частных мастеров, предлагающих подобные услуги."
    },
    {
        q: "Гарантируется ли работоспособность двигателя после перемотки?",
        a: "Да. После перемотки проводим испытания и выдаём гарантию на выполненные работы. Двигатель возвращается в работу только после проверки параметров."
    },
    {
        q: "Можно ли перемотать двигатель самостоятельно?",
        a: "Не рекомендуем: нужны специальное оборудование, материалы и опыт расчёта обмоток. Ошибка при самостоятельной перемотке часто приводит к повторному выходу из строя."
    }
] %}

{#
    Вкладки-фильтры (логика как на porozhek.ru/vopros-otvet/): все вопросы выводятся
    одним списком, у вопроса data-tag = id категории; таб показывает только свои вопросы.
    Номер 01, 02… считается CSS-счётчиком по видимым вопросам (на WP его не выводим).
    count — сколько демо-вопросов категории вывести (на WP — реальная выдача цикла).
#}
{% set faqTabs = [
    { id: "nasosy", title: "Насосы", count: 5 },
    { id: "electro", title: "Электродвигатели", count: 3 },
    { id: "benzo", title: "Бензогенераторы", count: 4 },
    { id: "alter", title: "Альтернаторы", count: 2 }
] %}

<section class="faq-page">
    <div class="container">
        {{ breadcrumbs(
            items=[
                { title: "Главная", url: "/home.html" },
                { title: "Вопрос-ответ" }
            ],
            separator="line",
            size="sm"
        ) }}

        <h1 class="faq-page-title" data-aos="fade-right">Вопрос-ответ</h1>

        {{ tabs(
            items=[{ id: "all", title: "Все вопросы", active: true }].concat(faqTabs),
            group="faq",
            class="faq-page-tabs"
        ) }}

        <div class="accordion faq-list" data-accordion="component" data-tabs-list="faq" data-aos="fade-up">
            {% for tab in faqTabs %}
                {% for i in range(0, tab.count) %}
                    {% set item = faqItems[i % (faqItems | length)] %}
                    <div class="item" data-accordion-item data-tag="{{ tab.id }}">
                        <button
                            type="button"
                            class="panel"
                            aria-expanded="false"
                            aria-controls="faq-{{ tab.id }}-{{ loop.index }}"
                        >
                            <span class="num"></span>
                            <span class="name">{{ item.q }}</span>
                            <span class="icon" aria-hidden="true">
                                <img src="/assets/images/system/icon-arrow-faq.svg" alt="" width="20" height="15" />
                            </span>
                        </button>
                        <div
                            class="collapse"
                            id="faq-{{ tab.id }}-{{ loop.index }}"
                            role="region"
                        >
                            <div class="wrap">
                                <p>{{ item.a }}</p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
    </div>
</section>