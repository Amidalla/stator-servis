{% endmacro %}

<section class="our-works" data-our-works>
    <div class="container">
        <div class="head">
            <h2 class="title">Наши работы</h2>
            {{ button(
                text="Смотреть другие работы",
                type="link",
                href="/nashi-raboty/",
                variant="white",
                class="more"
            ) }}
        </div>

        <div class="slider swiper">
            <div class="swiper-wrapper">
                <div class="swiper-slide">
                    <article class="card">
                        <div class="media">
                            <div class="gallery swiper">
                                <div class="swiper-wrapper">
                                    <div class="swiper-slide">
                                        <img
                                            class="lazy"
                                            data-src="/assets/images/content/our-works-pumps.png"
                                            alt="Диагностика насосов GRINDEX и FLYGT"
                                            width="416"
                                            height="405"
                                        />
                                    </div>
                                    <div class="swiper-slide">
                                        <img
                                            class="lazy"
                                            data-src="/assets/images/content/our-works-motor.png"
                                            alt="Насос после диагностики"
                                            width="416"
                                            height="405"
                                        />
                                    </div>
                                </div>
                                <span class="tag">Диагностика насосов</span>
                                {{ gallery_nav() }}
                            </div>
                        </div>
                        <div class="info">
                            <h3 class="name">Произведена разборка и диагностика насосов</h3>
                            <p class="model">Модель: <span>GRINDEX и FLYGT</span></p>
                            <ul class="specs">
                                <li><span class="key">Мощность:</span> <span class="val">20/18 кВт</span></li>
                                <li><span class="key">Частота вращения:</span> <span class="val">2900 об/мин</span></li>
                                <li><span class="key">Напряжение:</span> <span class="val">380 В</span></li>
                                <li><span class="key">Срок работ:</span> <span class="val">5 дней</span></li>
                            </ul>
                        </div>
                    </article>
                </div>

                <div class="swiper-slide">
                    <article class="card">
                        <div class="media">
                            <div class="gallery swiper">
                                <div class="swiper-wrapper">
                                    <div class="swiper-slide">
                                        <img
                                            class="lazy"
                                            data-src="/assets/images/content/our-works-motor.png"
                                            alt="Замена обмоток электродвигателя"
                                            width="416"
                                            height="405"
                                        />
                                    </div>
                                    <div class="swiper-slide">
                                        <img
                                            class="lazy"
                                            data-src="/assets/images/content/our-works-pumps.png"
                                            alt="Электродвигатель после ремонта"
                                            width="416"
                                            height="405"
                                        />
                                    </div>
                                </div>
                                <span class="tag">Замена обмоток электродвигателя</span>
                                {{ gallery_nav() }}
                            </div>
                        </div>
                        <div class="info">
                            <h3 class="name">Произведена <span class="accent">замена обмоток</span> электродвигателя</h3>
                            <p class="model">Модель: <span>АИР 132 M4</span></p>
                            <ul class="specs">
                                <li><span class="key">Мощность:</span> <span class="val">11 кВт</span></li>
                                <li><span class="key">Частота вращения:</span> <span class="val">1500 об/мин</span></li>
                                <li><span class="key">Напряжение:</span> <span class="val">380 В</span></li>
                                <li><span class="key">Срок работ:</span> <span class="val">7 дней</span></li>
                            </ul>
                        </div>
                    </article>
                </div>
            </div>
        </div>
    </div>
</section>
