        <button class="nav-btn prev" type="button" aria-label="Предыдущее фото">
            <svg xmlns="http://www.w3.org/2000/svg" width="58" height="63" viewBox="0 0 58 63" fill="none" aria-hidden="true">
                <path class="nav-bg" d="M0 0H58V63H0V0Z" fill="white" />
                <path
                    class="nav-arrow"
                    d="M39.7071 32.2071C40.0976 31.8166 40.0976 31.1834 39.7071 30.7929L33.3431 24.4289C32.9526 24.0384 32.3195 24.0384 31.9289 24.4289C31.5384 24.8195 31.5384 25.4526 31.9289 25.8431L37.5858 31.5L31.9289 37.1569C31.5384 37.5474 31.5384 38.1805 31.9289 38.5711C32.3195 38.9616 32.9526 38.9616 33.3431 38.5711L39.7071 32.2071ZM19 31.5V32.5H39V31.5V30.5H19V31.5Z"
                    fill="#D64212"
                />
            </svg>
        </button>
        <button class="nav-btn next" type="button" aria-label="Следующее фото">
            <svg xmlns="http://www.w3.org/2000/svg" width="58" height="63" viewBox="0 0 58 63" fill="none" aria-hidden="true">
                <path class="nav-bg" d="M0 0H58V63H0V0Z" fill="white" />
                <path
                    class="nav-arrow"
                    d="M39.7071 32.2071C40.0976 31.8166 40.0976 31.1834 39.7071 30.7929L33.3431 24.4289C32.9526 24.0384 32.3195 24.0384 31.9289 24.4289C31.5384 24.8195 31.5384 25.4526 31.9289 25.8431L37.5858 31.5L31.9289 37.1569C31.5384 37.5474 31.5384 38.1805 31.9289 38.5711C32.3195 38.9616 32.9526 38.9616 33.3431 38.5711L39.7071 32.2071ZM19 31.5V32.5H39V31.5V30.5H19V31.5Z"
                    fill="#D64212"
                />
            </svg>
        </button>
    </div>
{% endmacro %}

<section class="our-works" data-our-works>
    <div class="container">
        <div class="head">
            <h2 class="title">Наши работы</h2>
            {{ button(
                text="Смотреть другие работы",
                type="link",
                href="/nashi-raboty/",
                variant="white",
                class="more"
            ) }}
        </div>

        <div class="slider swiper">
            <div class="swiper-wrapper">
                <div class="swiper-slide">
                    <article class="card">
                        <div class="media">
                            <div class="gallery swiper">
                                <div class="swiper-wrapper">
                                    <div class="swiper-slide">
                                        <img
                                            class="lazy"
                                            data-src="/assets/images/content/our-works-pumps.png"
                                            alt="Диагностика насосов GRINDEX и FLYGT"
                                            width="416"
                                            height="405"
                                        />
                                    </div>
                                    <div class="swiper-slide">
                                        <img
                                            class="lazy"
                                            data-src="/assets/images/content/our-works-motor.png"
                                            alt="Насос после диагностики"
                                            width="416"
                                            height="405"
                                        />
                                    </div>
                                </div>
                                <span class="tag">Диагностика насосов</span>
                                {{ gallery_nav() }}
                            </div>
                        </div>
                        <div class="info">
                            <h3 class="name">Произведена разборка и диагностика насосов</h3>
                            <p class="model">Модель: <span>GRINDEX и FLYGT</span></p>
                            <ul class="specs">
                                <li><span class="key">Мощность:</span> <span class="val">20/18 кВт</span></li>
                                <li><span class="key">кВт:</span> <span class="val">2900</span></li>
                                <li><span class="key">Об/мин:</span> <span class="val">23/20</span></li>
                            </ul>
                        </div>
                    </article>
                </div>

                <div class="swiper-slide">
                    <article class="card">
                        <div class="media">
                            <div class="gallery swiper">
                                <div class="swiper-wrapper">
                                    <div class="swiper-slide">
                                        <img
                                            class="lazy"
                                            data-src="/assets/images/content/our-works-motor.png"
                                            alt="Замена обмоток электродвигателя"
                                            width="416"
                                            height="405"
                                        />
                                    </div>
                                    <div class="swiper-slide">
                                        <img
                                            class="lazy"
                                            data-src="/assets/images/content/our-works-pumps.png"
                                            alt="Электродвигатель после ремонта"
                                            width="416"
                                            height="405"
                                        />
                                    </div>
                                </div>
                                <span class="tag">Замена обмоток электродвигателя</span>
                                {{ gallery_nav() }}
                            </div>
                        </div>
                        <div class="info">
                            <h3 class="name">Произведена замена обмоток электродвигателя</h3>
                            <p class="model">Модель: <span>TEE</span></p>
                            <ul class="specs">
                                <li><span class="key">кВт:</span> <span class="val">37</span></li>
                                <li><span class="key">Об/мин:</span> <span class="val">1500</span></li>
                            </ul>
                        </div>
                    </article>
                </div>
            </div>
        </div>

        <div class="mobile-nav">
            <button class="nav-btn prev" type="button" aria-label="Предыдущая работа">
                <svg xmlns="http://www.w3.org/2000/svg" width="58" height="63" viewBox="0 0 58 63" fill="none" aria-hidden="true">
                    <path class="shape" d="M58 0H8L0 63H58V0Z" fill="#D9D9D9"/>
                    <path class="arrow" d="M22.2929 32.2071C21.9024 31.8166 21.9024 31.1834 22.2929 30.7929L28.6569 24.4289C29.0474 24.0384 29.6805 24.0384 30.0711 24.4289C30.4616 24.8195 30.4616 25.4526 30.0711 25.8431L24.4142 31.5L30.0711 37.1569C30.4616 37.5474 30.4616 38.1805 30.0711 38.5711C29.6805 38.9616 29.0474 38.9616 28.6569 38.5711L22.2929 32.2071ZM43 31.5V32.5H23V31.5V30.5H43V31.5Z" fill="#D64212"/>
                </svg>
            </button>
            <div class="fraction" aria-live="polite">1/2</div>
            <button class="nav-btn next" type="button" aria-label="Следующая работа">
                <svg xmlns="http://www.w3.org/2000/svg" width="58" height="63" viewBox="0 0 58 63" fill="none" aria-hidden="true">
                    <path class="shape" d="M0 0H50L58 63H0V0Z" fill="#D9D9D9"/>
                    <path class="arrow" d="M34.8751 32.2071C35.2656 31.8166 35.2656 31.1834 34.8751 30.7929L28.5111 24.4289C28.1206 24.0384 27.4874 24.0384 27.0969 24.4289C26.7064 24.8195 26.7064 25.4526 27.0969 25.8431L32.7538 31.5L27.0969 37.1569C26.7064 37.5474 26.7064 38.1805 27.0969 38.5711C27.4874 38.9616 28.1206 38.9616 28.5111 38.5711L34.8751 32.2071ZM14.168 31.5V32.5H34.168V31.5V30.5H14.168V31.5Z" fill="#D64212"/>
                </svg>
            </button>
        </div>
    </div>
</section>
