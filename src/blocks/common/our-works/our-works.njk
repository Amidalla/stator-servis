        <button class="nav-btn next" type="button" aria-label="Следующее фото">
            <svg xmlns="http://www.w3.org/2000/svg" width="58" height="63" viewBox="0 0 58 63" fill="none" aria-hidden="true">
                <path class="nav-bg" d="M0 0H58V63H0V0Z" fill="white" />
                <path
                    class="nav-arrow"
                    d="M39.7071 32.2071C40.0976 31.8166 40.0976 31.1834 39.7071 30.7929L33.3431 24.4289C32.9526 24.0384 32.3195 24.0384 31.9289 24.4289C31.5384 24.8195 31.5384 25.4526 31.9289 25.8431L37.5858 31.5L31.9289 37.1569C31.5384 37.5474 31.5384 38.1805 31.9289 38.5711C32.3195 38.9616 32.9526 38.9616 33.3431 38.5711L39.7071 32.2071ZM19 31.5V32.5H39V31.5V30.5H19V31.5Z"
                    fill="#D64212"
                />
            </svg>
