{% from "components/general/slider-nav/slider-nav.njk" import navBtn, mobileNav %}

{% macro star_icon() %}
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
            d="M10.839 0.697887C11.1325 -0.235501 12.4534 -0.235498 12.7469 0.697889L14.8283 7.31725C14.9593 7.73387 15.3455 8.01729 15.7823 8.01729H22.5857C23.5465 8.01729 23.9544 9.24016 23.1861 9.817L17.6262 13.9912C17.2871 14.2457 17.1454 14.6864 17.2726 15.0908L19.3829 21.8021C19.6744 22.7293 18.6058 23.4853 17.8286 22.9018L12.3934 18.8213C12.0376 18.5542 11.5483 18.5542 11.1926 18.8213L5.75737 22.9018C4.98016 23.4853 3.91151 22.7293 4.20303 21.8021L6.31332 15.0908C6.44049 14.6864 6.29881 14.2457 5.95976 13.9912L0.399828 9.817C-0.368504 9.24016 0.0394521 8.01729 1.00022 8.01729H7.80368C8.24042 8.01729 8.62663 7.73387 8.75764 7.31725L10.839 0.697887Z"
            fill="currentColor"
        />
    </svg>
{% endmacro %}

{% macro stars(rating=5) %}
    {% set full = rating | round(0, "floor") %}
    {% set has_half = rating > full %}
    <div class="stars" role="img" aria-label="Оценка {{ rating }} из 5">
        {% for i in range(1, 6) %}
            {% if i <= full %}
                <span class="star is-full">{{ star_icon() }}</span>
            {% elif has_half and i == full + 1 %}
                <span class="star is-half">
                    <span class="base">{{ star_icon() }}</span>
                    <span class="fill">{{ star_icon() }}</span>
                </span>
            {% else %}
                <span class="star is-empty">{{ star_icon() }}</span>
            {% endif %}
        {% endfor %}
    </div>
{% endmacro %}

<section class="reviews" data-reviews>
    <div class="container">
        <div class="layout">
            <div class="intro" data-aos="fade-right">
                <h2 class="title">Отзывы</h2>
                <p class="lead">
                    Нам доверяют предприятия по всей России. Ремонтируем оборудование, на которое можно положиться.
                </p>

