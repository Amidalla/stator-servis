<section class="article-detail" data-detail-gallery>
    <div class="container">
        {{ breadcrumbs(
            items=[
                { title: "Главная", url: "/home.html" },
                { title: "Блог и новости", url: "/blog-i-novosti/" },
                { title: "Экстренный ремонт электродвигателя" }
            ],
            separator="line",
            size="sm"
        ) }}

        <div class="head" data-aos="fade-up">
            <h1 class="title">
                Экстренный ремонт электродвигателя: пошаговый план первых 30 минут, чтобы избежать капитальной замены
            </h1>
        </div>

        <div class="layout">
            {# Вводный блок: галерея (слайдер как на деталке услуг) + текст #}
            <div class="intro" data-aos="fade-up">
                <div class="intro-row">
                    <div class="gallery-col">
                        <span class="counter"
                            ><b>1</b>/<span class="total">{{ photos | length }}</span>&nbsp;фото</span>
                        <div class="gallery">
                            <div class="thumbs">
                                <div class="thumbs-swiper swiper" data-thumbs>
                                    <div class="swiper-wrapper">
                                        {% for photo in photos %}
                                            <div class="swiper-slide thumb">
                                                <img
                                                    class="lazy"
                                                    src="/assets/images/content/{{ photo.thumb }}"
                                                    data-src="/assets/images/content/{{ photo.thumb }}"
                                                    alt="Экстренный ремонт электродвигателя — фото {{ loop.index }}"
                                                    width="125"
                                                    height="127"
                                                />
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                                {{ thumbsNav() }}
                            </div>

                            <div class="stage">
                                <div class="main-swiper swiper" data-main>
