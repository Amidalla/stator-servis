                                                                cy="10.5"
                                                                r="7"
                                                                stroke="currentColor"
                                                                stroke-width="1.8"
                                                            />
                                                            <path
                                                                d="M20 20L16 16"
                                                                stroke="currentColor"
                                                                stroke-width="1.8"
                                                                stroke-linecap="round"
                                                            />
                                                            <path
