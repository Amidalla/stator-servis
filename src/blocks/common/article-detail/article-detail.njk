                                                    aria-label="Открыть фото {{ loop.index }} в полном размере"
                                                >
                                                    <img
                                                        class="main lazy"
                                                        src="/assets/images/content/{{ photo.main }}"
                                                        data-src="/assets/images/content/{{ photo.main }}"
                                                        alt="Экстренный ремонт электродвигателя — фото {{ loop.index }}"
                                                        width="570"
                                                        height="473"
                                                    />
