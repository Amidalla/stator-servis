{% from "components/general/button/button.njk" import render as button %}
{% from "components/general/breadcrumbs/breadcrumbs.njk" import render as breadcrumbs %}

{% macro thumbsNav() %}
    <button class="thumbs-nav" type="button" aria-label="Следующее фото">
        <svg
            class="ic ic-default"
            xmlns="http://www.w3.org/2000/svg"
            width="58"
            height="63"
            viewBox="0 0 58 63"
            fill="none"
            aria-hidden="true"
        >
            <path d="M0 0H50L58 63H0V0Z" fill="#D64212" />
            <path
                d="M34.8751 32.2071C35.2656 31.8166 35.2656 31.1834 34.8751 30.7929L28.5111 24.4289C28.1206 24.0384 27.4874 24.0384 27.0969 24.4289C26.7064 24.8195 26.7064 25.4526 27.0969 25.8431L32.7538 31.5L27.0969 37.1569C26.7064 37.5474 26.7064 38.1805 27.0969 38.5711C27.4874 38.9616 28.1206 38.9616 28.5111 38.5711L34.8751 32.2071ZM14.168 31.5V32.5H34.168V31.5V30.5H14.168V31.5Z"
                fill="white"
            />
        </svg>
        <svg
            class="ic ic-hover"
            xmlns="http://www.w3.org/2000/svg"
            width="63"
            height="58"
            viewBox="0 0 63 58"
            fill="none"
            aria-hidden="true"
        >
            <path d="M63 0L63 50L0 58L0 0L63 0Z" fill="url(#sdh-thumb-grad)" />
            <path
                d="M30.7929 34.8712C31.1834 35.2617 31.8166 35.2617 32.2071 34.8712L38.5711 28.5072C38.9616 28.1167 38.9616 27.4835 38.5711 27.093C38.1805 26.7025 37.5474 26.7025 37.1569 27.093L31.5 32.7499L25.8431 27.093C25.4526 26.7025 24.8195 26.7025 24.4289 27.093C24.0384 27.4835 24.0384 28.1167 24.4289 28.5072L30.7929 34.8712ZM31.5 14.1641L30.5 14.1641L30.5 34.1641L31.5 34.1641L32.5 34.1641L32.5 14.1641L31.5 14.1641Z"
                fill="white"
            />
            <defs>
                <radialGradient
                    id="sdh-thumb-grad"
                    cx="0"
                    cy="0"
                    r="1"
                    gradientTransform="matrix(32.6226 19.0097 -80.1238 1.4431 13.7308 0.547291)"
                    gradientUnits="userSpaceOnUse"
                >
                    <stop stop-color="#A70000" />
                    <stop offset="1" stop-color="#D64212" />
                </radialGradient>
            </defs>
        </svg>
    </button>
{% endmacro %}

{% set photos = [
    { main: "service-detail-main.png", thumb: "service-detail-thumb-1.png" },
    { main: "service-detail-thumb-2.png", thumb: "service-detail-thumb-2.png" },
    { main: "service-detail-thumb-3.png", thumb: "service-detail-thumb-3.png" },
    { main: "service-detail-thumb-1.png", thumb: "service-detail-thumb-1.png" },
    { main: "service-detail-thumb-5.png", thumb: "service-detail-thumb-5.png" }
] %}

<section class="service-detail-hero" data-detail-gallery>
    <span class="watermark" aria-hidden="true"></span>
    <div class="container">
        {{ breadcrumbs(
            items=[
                { title: "Главная", url: "/home.html" },
                { title: "Ремонт электродвигателей", url: "/service-category/" },
                { title: "Перемотка электромагнитных катушек" }
            ],
            separator="line",
            size="sm"
        ) }}

        <div class="content" data-aos="fade-up">
            <h1 class="title">Перемотка электромагнитных катушек</h1>

            <div class="body">
                <span class="counter"><b>1</b>/<span class="total">{{ photos | length }}</span>&nbsp;фото</span>

                <div class="layout">
                    <div class="gallery">
                        <div class="thumbs">
                            <div class="thumbs-swiper swiper" data-thumbs>
                                <div class="swiper-wrapper">
                                    {% for photo in photos %}
                                        <div class="swiper-slide thumb">
                                            <img
                                                class="lazy"
                                                src="/assets/images/content/{{ photo.thumb }}"
                                                data-src="/assets/images/content/{{ photo.thumb }}"
                                                alt="Перемотка электромагнитных катушек — фото {{ loop.index }}"
                                                width="125"
                                                height="127"
                                            />
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                            {{ thumbsNav() }}
                        </div>

                        <div class="stage">
                            <div class="main-swiper swiper" data-main>
                                <div class="swiper-wrapper">
                                    {% for photo in photos %}
                                        <div class="swiper-slide">
                                            <a
                                                class="main-link"
                                                href="/assets/images/content/{{ photo.main }}"
                                                data-fancybox="service-detail-gallery"
                                                data-caption="Перемотка электромагнитных катушек — фото {{ loop.index }}"
                                                aria-label="Открыть фото {{ loop.index }} в полном размере"
                                            >
                                                <img
                                                    class="main lazy"
                                                    src="/assets/images/content/{{ photo.main }}"
                                                    data-src="/assets/images/content/{{ photo.main }}"
                                                    alt="Перемотка электромагнитных катушек — фото {{ loop.index }}"
                                                    width="570"
                                                    height="473"
                                                />
                                                <span class="zoom-ic" aria-hidden="true">
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        width="24"
                                                        height="24"
                                                        viewBox="0 0 24 24"
                                                        fill="none"
                                                    >
                                                        <circle
                                                            cx="10.5"
                                                            cy="10.5"
                                                            r="7"
                                                            stroke="currentColor"
                                                            stroke-width="1.8"
                                                        />
                                                        <path
                                                            d="M20 20L16 16"
                                                            stroke="currentColor"
                                                            stroke-width="1.8"
                                                            stroke-linecap="round"
                                                        />
                                                        <path
                                                            d="M10.5 7.5V13.5M7.5 10.5H13.5"
                                                            stroke="currentColor"
                                                            stroke-width="1.8"
                                                            stroke-linecap="round"
                                                        />
                                                    </svg>
                                                </span>
                                            </a>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="info">
                        <div class="text">
                            <h2>Почему важно состояние электромагнитной катушки</h2>
                            <p>
                                Когда долго работаешь с электродвигателями и трансформаторным оборудованием, быстро
                                понимаешь: электромагнитная катушка&nbsp;— деталь маленькая, но&nbsp;ключевая.
                                От&nbsp;её состояния зависит, будет ли устройство работать стабильно или внезапно
                                «встанет» в&nbsp;самый неподходящий момент.
                            </p>
                        </div>

                        <div class="offer">
                            <div class="features">
                                <div class="feature">
                                    <span class="feature-value">3-7 дней</span>
                                    <span class="feature-label">Срок выполнения</span>
                                </div>
                                <div class="feature">
                                    <span class="feature-value">Гарантия 6 мес</span>
                                    <span class="feature-label">На все работы</span>
                                </div>
                            </div>

                            <div class="price">
                                <span class="price-label">Стоимость от</span>
                                <span class="price-value">3000&nbsp;₽</span>
                            </div>

                            <div class="actions">
                                {{ button(
                                    text="Заказать",
                                    type="button",
                                    variant="red",
                                    class="btn-order",
                                    data={"src": "popup-order", "service": "Перемотка электромагнитных катушек"}
                                ) }}
                                {{ button(
                                    text="Бесплатная консультация",
                                    type="button",
                                    variant="outline",
                                    class="btn-consult",
                                    data={"src": "popup-callback"}
                                ) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>