{% from "components/general/navigation-top/navigation-top.njk" import render as navigationTop %}
{% from "components/general/logo/logo.njk" import render as logo %}

<header class="header">
    <div class="container">
        <div class="header-logo">
            {{ logo(
                image="/assets/images/system/logo.svg",
                imageMobile="/assets/images/system/logo-mobile.svg",
                alt="Статор-Сервис"
            ) }}
        </div>

        <div class="header-main">
            <div class="header-top">
                {% include "components/common/contacts-header/contacts-header.njk" %}
            </div>
            <div class="header-nav">
                {{ navigationTop(
                     items=[
                         { title: "О компании", href: "/o-nas/" },
                         { title: "Ремонт", href: "/uslugi/remont-elektrodvigateley/" },
                         { title: "Перемотка", href: "/uslugi/" },
                         { title: "Балансировка", href: "/uslugi/" },
                         { title: "Цены", href: "/cena/" },
                         { title: "Наши работы", href: "/nashi-raboty/" },
                         { title: "Блог", href: "/блог-и-новости/" },
                         { title: "Контакты", href: "/contact/" }
                     ]
                ) }}
            </div>
        </div>

        <div class="header-socials">
            <a
                class="header-socials-link"
                href="https://t.me/+79218454400"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Telegram"
            >
                <img src="/assets/images/system/icon-telegram.svg" alt="" width="30" height="30" />
            </a>
            <a
                class="header-socials-link"
                href="https://max.ru/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Max"
            >
                <span class="header-socials-max">
                    <img src="/assets/images/system/icon-max.svg" alt="" width="24" height="24" />
                </span>
            </a>
        </div>

        <div class="header-menu">
            {% include "components/general/menu/menu-open.njk" %}
        </div>
    </div>

    <div class="header-actions">
        <button class="header-callback" type="button" data-src="popup-callback">
            <span>Заказать звонок</span>
        </button>
        <div class="header-search">
            {% include "components/general/search-form/search-form.njk" %}
        </div>
    </div>
</header>
