{% from "components/general/navigation-top/navigation-top.njk" import render as navigationTop %}
{% from "components/general/logo/logo.njk" import render as logo %}

<header class="header">
    <div class="container">
        <div class="header-logo">
            {{ logo(
                image="/assets/images/system/logo.svg",
                imageMobile="/assets/images/system/logo-mobile.svg",
                alt="Статор-Сервис"
            ) }}
        </div>

        <div class="header-main">
            <div class="header-top">
                {% include "components/common/contacts-header/contacts-header.njk" %}
            </div>
            <div class="header-nav">
                {{ navigationTop(
                     items=[
                         { title: "О компании", href: "/o-nas/" },
                         {
                             title: "Ремонт",
                             children: [
                                 { title: "Электродвигатели", href: "/service-category/" },
                                 { title: "Насосы", href: "/service-category/" },
                                 { title: "Бензогенераторы", href: "/service-category/" },
                                 { title: "Вентиляторы", href: "/service-category/" }
                             ]
                         },
                         {
                             title: "Перемотка",
                             children: [
                                 { title: "Электродвигатели", href: "/service-category/" },
                                 { title: "Бензогенераторы", href: "/service-category/" },
                                 { title: "Альтернаторы", href: "/service-category/" },
                                 { title: "Трансформаторы", href: "/service-category/" },
                                 { title: "Катушки", href: "/service-category/" }
                             ]
                         },
                         {
                             title: "Балансировка",
                             children: [
                                 { title: "Роторы", href: "/service-category/" },
                                 { title: "Якоря", href: "/service-category/" },
                                 { title: "Муфты", href: "/service-category/" },
                                 { title: "Промышленные вентиляторы", href: "/service-category/" }
                             ]
                         },
                         { title: "Цены", href: "/cena/" },
                         { title: "Наши работы", href: "/nashi-raboty/" },
                         { title: "Блог", href: "/blog-i-novosti/" },
                         { title: "Контакты", href: "/contact/" }
                     ]
                ) }}
            </div>
        </div>

        <div class="header-socials">
            <a
                class="header-socials-link"
                href="https://t.me/+79218454400"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Telegram"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="30"
                    height="30"
                    viewBox="0 0 30 30"
                    fill="none"
                    aria-hidden="true"
                >
                    <rect width="30" height="30" rx="1" fill="white" />
                    <path
                        d="M23.3036 6.88037C20.6651 7.97299 9.35208 12.6591 6.2262 13.9363C4.12979 14.7544 5.35694 15.5214 5.35694 15.5214C5.35694 15.5214 7.1464 16.1348 8.68029 16.595C10.2142 17.0553 11.0323 16.5439 11.0323 16.5439L18.2415 11.6864C20.7979 9.94814 20.1844 11.3797 19.571 11.9932C18.2415 13.3226 16.043 15.4188 14.2024 17.1062C13.3843 17.822 13.7933 18.4357 14.1512 18.7424C15.4807 19.8672 19.1108 22.1681 19.3154 22.3215C20.3956 23.0862 22.5202 24.187 22.8434 21.8613L24.1217 13.834C24.5307 11.1241 24.9398 8.61867 24.9909 7.90289C25.1442 6.16458 23.3036 6.88037 23.3036 6.88037Z"
                        fill="#383838"
                    />
                </svg>
            </a>
            <a
                class="header-socials-link"
                href="https://max.ru/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Max"
            >
                <span class="header-socials-max">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        aria-hidden="true"
                    >
                        <g clip-path="url(#header-icon-max)">
                            <path
                                d="M11.6804 0.3211C4.72705 0.684433 0.137055 6.13777 0.427054 13.0144C0.553721 16.0244 1.76372 18.6144 2.05039 21.4711C2.12372 22.2111 1.91039 23.1244 2.76372 23.4478C3.81372 23.8444 5.42372 23.1778 6.30372 22.5678C6.60372 22.3644 6.89039 22.1278 7.11039 21.8344C8.02039 22.4378 8.88372 23.0211 9.96705 23.2811C14.7371 24.4244 19.9637 21.8078 22.2871 17.6044C26.6537 9.70776 20.7504 -0.152234 11.6804 0.3211ZM8.98039 16.8011C8.60372 17.0944 8.24039 17.4944 7.82372 17.7244C7.22039 18.0478 7.03372 17.7111 6.80705 17.1778C6.09372 15.4811 6.00705 12.5911 6.42372 10.8144C6.98372 8.39777 8.85372 6.2711 11.4237 6.04443C14.0237 5.81443 16.4371 7.13443 17.5271 9.51777C19.9404 14.8211 13.7637 20.0578 8.98039 16.8044V16.8011Z"
                                fill="#383838"
                            />
                        </g>
                        <defs>
                            <clipPath id="header-icon-max">
                                <rect width="24" height="24" fill="white" />
                            </clipPath>
                        </defs>
                    </svg>
                </span>
            </a>
        </div>

        <div class="header-menu">
            {% include "components/general/menu/menu-open.njk" %}
        </div>
    </div>

    <div class="header-actions">
        <button class="header-callback" type="button" data-src="popup-callback">
            <span>Заказать звонок</span>
        </button>
        <div class="header-search">
            {% include "components/general/search-form/search-form.njk" %}
        </div>
    </div>
</header>