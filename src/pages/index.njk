{% set title = "Статор-Сервис" %}
{% set url = "https://stator-servis.ru/" %}
<!DOCTYPE html>
<html lang="ru">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{{ title }} — карта страниц</title>
        <link rel="icon" href="./assets/favicons/favicon.svg" type="image/svg+xml" />
        <style>
            @font-face {
                font-family: "Noto Sans";
                font-style: normal;
                font-weight: 400;
                font-display: swap;
                src: url("./assets/fonts/NotoSans-Regular.ttf") format("truetype");
            }

            @font-face {
                font-family: "Noto Sans";
                font-style: normal;
                font-weight: 600;
                font-display: swap;
                src: url("./assets/fonts/NotoSans-SemiBold.ttf") format("truetype");
            }

            @font-face {
                font-family: "Tektur";
                font-style: normal;
                font-weight: 500 700;
                font-display: swap;
                src: url("./assets/fonts/Tektur.ttf") format("truetype");
            }

            :root {
                --white: #fff;
                --dark: #161616;
                --dark-soft: #232323;
                --grey: #a8a8a8;
                --light-grey: #d9d9d9;
                --orange: #d64212;
                --orange-dark: #b9370f;
                --blue-glow: #064aa7;
            }

            * {
                box-sizing: border-box;
            }

            body {
                min-height: 100vh;
                margin: 0;
                font-family: "Noto Sans", system-ui, sans-serif;
                color: var(--white);
                background: var(--dark);
            }

            .background {
                position: fixed;
                inset: 0;
                z-index: -1;
                overflow: hidden;
                background:
                    linear-gradient(105deg, rgb(22 22 22 / 94%) 0%, rgb(22 22 22 / 82%) 48%, rgb(214 66 18 / 28%) 100%),
                    url("./assets/images/content/hero-desktop.png") center / cover;
            }

            .background::before,
            .background::after {
                position: absolute;
                content: "";
                border-radius: 50%;
                filter: blur(2px);
            }

            .background::before {
                top: -220px;
                right: -160px;
                width: 600px;
                height: 600px;
                background: rgb(214 66 18 / 22%);
            }

            .background::after {
                bottom: -260px;
                left: -140px;
                width: 520px;
                height: 520px;
                background: rgb(6 74 167 / 16%);
            }

            .page {
                width: min(100%, 1180px);
                padding: 48px 30px 72px;
                margin: 0 auto;
            }

            .hero {
                margin-bottom: 36px;
            }

            .brand {
                display: inline-flex;
                align-items: center;
                text-decoration: none;
            }

            .brand img {
                display: block;
                width: 168px;
                height: auto;
            }

            h1 {
                max-width: 760px;
                margin: 26px 0 10px;
                font-family: "Tektur", "Noto Sans", sans-serif;
                font-size: clamp(38px, 5vw, 56px);
                font-weight: 600;
                line-height: 110%;
                color: var(--white);
            }

            .intro {
                max-width: 575px;
                margin: 0;
                font-size: 18px;
                line-height: 140%;
                color: var(--light-grey);
            }

            .groups {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 20px;
            }

            .group {
                padding: 22px;
                background: rgb(35 35 35 / 88%);
                border: 1px solid rgb(255 255 255 / 10%);
                border-radius: 10px;
                box-shadow: 0 10px 28px rgb(0 0 0 / 28%);
                backdrop-filter: blur(8px);
            }

            .group--main {
                grid-column: span 2;
            }

            .group-title {
                display: flex;
                gap: 10px;
                align-items: center;
                margin: 0 0 16px;
                font-family: "Tektur", "Noto Sans", sans-serif;
                font-size: 18px;
                font-weight: 600;
                color: var(--white);
            }

            .group-title::before {
                width: 10px;
                height: 10px;
                content: "";
                background: var(--orange);
                border-radius: 2px;
            }

            .list {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 10px;
                padding: 0;
                margin: 0;
                list-style: none;
            }

            .group--content .list,
            .group--system .list {
                grid-template-columns: 1fr;
            }

            .list a {
                display: flex;
                gap: 12px;
                align-items: center;
                justify-content: space-between;
                min-height: 82px;
                padding: 14px 16px;
                color: var(--white);
                text-decoration: none;
                background: rgb(22 22 22 / 72%);
                border: 1px solid transparent;
                border-radius: 8px;
                transition:
                    color 0.25s ease,
                    border-color 0.25s ease,
                    background-color 0.25s ease,
                    transform 0.25s ease,
                    box-shadow 0.25s ease;
            }

            .list a:hover {
                color: var(--white);
                background: rgb(22 22 22 / 92%);
                border-color: var(--orange);
                box-shadow: inset 0 0 0 1px rgb(6 74 167 / 35%);
                transform: translateY(-2px);
            }

            .name {
                display: block;
                font-size: 16px;
                font-weight: 600;
                line-height: 130%;
            }

            .file {
                display: block;
                margin-top: 4px;
                font-size: 13px;
                font-weight: 400;
                color: rgb(217 217 217 / 55%);
            }

            .arrow {
                flex: 0 0 auto;
                color: var(--orange);
                font-size: 24px;
                line-height: 1;
            }

            .footer {
                display: flex;
                gap: 18px;
                align-items: center;
                justify-content: space-between;
                padding-top: 22px;
                margin-top: 28px;
                border-top: 1px solid rgb(255 255 255 / 12%);
            }

            .footer p {
                margin: 0;
                font-size: 14px;
                color: var(--grey);
            }

            .footer a {
                padding: 10px 16px;
                color: var(--white);
                font-size: 14px;
                font-weight: 600;
                text-decoration: none;
                background: var(--orange);
                border-radius: 5px;
                transition: background-color 0.25s ease;
            }

            .footer a:hover {
                background: var(--orange-dark);
            }

            @media (max-width: 1023px) {
                .groups {
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }

                .group--main {
                    grid-column: span 2;
                }
            }

            @media (max-width: 767px) {
                .page {
                    padding: 30px 15px 48px;
                }

                .groups {
                    grid-template-columns: 1fr;
                }

                .hero {
                    margin-bottom: 24px;
                }

                .brand img {
                    width: 140px;
                }

                .group--main {
                    grid-column: auto;
                }

                .list {
                    grid-template-columns: 1fr;
                }

                .footer {
                    flex-direction: column;
                    align-items: flex-start;
                }
            }
        </style>
    </head>
    <body>
        <div class="background" aria-hidden="true"></div>
        <main class="page">
            <section class="hero">
                <div>
                    <a class="brand" href="./home.html" aria-label="Статор-Сервис — на главную">
                        <img src="./assets/images/system/logo.svg" alt="Статор-Сервис" width="168" height="42" />
                    </a>
                    <h1>Карта страниц</h1>
                    <p class="intro">Навигация по макетам сайта ремонта электродвигателей «Статор-Сервис».</p>
                </div>
            </section>

            {% macro pageLink(title, file) %}
                <li>
                    <a href="./{{ file }}">
                        <span
                            ><span class="name">{{ title }}</span><span class="file">{{ file }}</span></span>
                        <span class="arrow" aria-hidden="true">→</span>
                    </a>
                </li>
            {% endmacro %}

            <div class="groups">
                <section class="group group--main">
                    <h2 class="group-title">Основные страницы</h2>
                    <ul class="list">
                        {{ pageLink("Главная", "home.html") }}
                        {{ pageLink("О компании", "o-nas/") }}
                        {{ pageLink("Услуга — категория", "service-category/") }}
                        {{ pageLink("Услуга — детальная", "service-category/service-detail/") }}
                        {{ pageLink("Наши работы", "nashi-raboty/") }}
                        {{ pageLink("Работа — детальная", "nashi-raboty/works-detail/") }}
                    </ul>
                </section>

                <section class="group group--content">
                    <h2 class="group-title">Контент и сервисы</h2>
                    <ul class="list">
                        {{ pageLink("Блог и новости", "blog-i-novosti/") }}
                        {{ pageLink("Статья — детальная", "blog-i-novosti/article-detail/") }}
                        {{ pageLink("Цены", "cena/") }}
                        {{ pageLink("Вопрос–ответ", "faq/") }}
                        {{ pageLink("Контакты", "contact/") }}
                        {{ pageLink("Результаты поиска", "poisk/") }}
                    </ul>
                </section>

                <section class="group group--system">
                    <h2 class="group-title">Служебные</h2>
                    <ul class="list">
                        {{ pageLink("Политика конфиденциальности", "persdan/") }}
                        {{ pageLink("Ошибка 404", "404.html") }}
                    </ul>
                </section>
            </div>

            <footer class="footer">
                <p>Карта страниц для разработки сайта</p>
                <a href="./home.html">Открыть главную</a>
            </footer>
        </main>
    </body>
</html>