{% macro render(
        title="Мы используем файлы cookies",
        content="",
        buttonText="Принять",
        id="",
        class="",
        data={},
        aria={}
    ) %}
    {% from "components/general/button/button.njk" import render as button %}

    {% set noticeClasses = "consent-notice" %}
    {% if class %}
        {% set noticeClasses = noticeClasses + " " + class %}
    {% endif %}

    <div
        class="{{ noticeClasses }}"
        {% if id %}id="{{ id }}"{% endif %}
        data-consent="notice"
        {% if data %}
            {% for key, val in data %}
                data-{{ key | replace("_", "-") }}="{{ val }}"
            {% endfor %}
        {% endif %}
        role="dialog"
        aria-labelledby="consent-notice-title"
        {% if aria %}
            {% for key, val in aria %}
                aria-{{ key | replace("_", "-") }}="{{ val }}"
            {% endfor %}
        {% endif %}
    >
        <div class="container">
            <div class="block">
                <div class="copy">
                    <div class="title" id="consent-notice-title">{{ title }}</div>
                    <div class="text">{{ content | safe }}</div>
                </div>
                <div class="actions">
                    {{ button(
                        type="button",
                        text=buttonText,
                        variant="red",
                        data={ consent: "accept" },
                        aria={ label: "Принять условия" }
                    ) }}
                </div>
            </div>
        </div>
    </div>
{% endmacro %}
