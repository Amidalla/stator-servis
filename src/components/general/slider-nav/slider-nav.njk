{% macro navBtn(direction="prev", label="", class="", disabled=false, href="") %}
    {% set navClass = "nav-btn " + direction %}
    {% if class %}
        {% set navClass = navClass + " " + class %}
    {% endif %}
    {% set navLabel = label if label else ("Предыдущий слайд" if direction == "prev" else "Следующий слайд") %}

    {% if direction == "prev" %}
        {% set navSvg %}
            <svg xmlns="http://www.w3.org/2000/svg" width="58" height="63" viewBox="0 0 58 63" fill="none" aria-hidden="true">
                <path class="shape" d="M58 0H8L0 63H58V0Z" fill="#D9D9D9" />
                <path
                    class="arrow"
                    d="M22.2929 32.2071C21.9024 31.8166 21.9024 31.1834 22.2929 30.7929L28.6569 24.4289C29.0474 24.0384 29.6805 24.0384 30.0711 24.4289C30.4616 24.8195 30.4616 25.4526 30.0711 25.8431L24.4142 31.5L30.0711 37.1569C30.4616 37.5474 30.4616 38.1805 30.0711 38.5711C29.6805 38.9616 29.0474 38.9616 28.6569 38.5711L22.2929 32.2071ZM43 31.5V32.5H23V31.5V30.5H43V31.5Z"
                    fill="#D64212"
                />
            </svg>
        {% endset %}
    {% else %}
        {% set navSvg %}
            <svg xmlns="http://www.w3.org/2000/svg" width="58" height="63" viewBox="0 0 58 63" fill="none" aria-hidden="true">
                <path class="shape" d="M0 0H50L58 63H0V0Z" fill="#D9D9D9" />
                <path
                    class="arrow"
                    d="M34.8751 32.2071C35.2656 31.8166 35.2656 31.1834 34.8751 30.7929L28.5111 24.4289C28.1206 24.0384 27.4874 24.0384 27.0969 24.4289C26.7064 24.8195 26.7064 25.4526 27.0969 25.8431L32.7538 31.5L27.0969 37.1569C26.7064 37.5474 26.7064 38.1805 27.0969 38.5711C27.4874 38.9616 28.1206 38.9616 28.5111 38.5711L34.8751 32.2071ZM14.168 31.5V32.5H34.168V31.5V30.5H14.168V31.5Z"
                    fill="#D64212"
                />
            </svg>
        {% endset %}
    {% endif %}

    {% if disabled %}
        <span
            class="{{ navClass }}"
            role="button"
            aria-disabled="true"
            aria-label="{{ navLabel }}"
        >
            {{ navSvg | safe }}
        </span>
    {% elif href %}
        <a
            class="{{ navClass }}"
            href="{{ href }}"
            aria-label="{{ navLabel }}"
        >
            {{ navSvg | safe }}
        </a>
    {% else %}
        <button class="{{ navClass }}" type="button" aria-label="{{ navLabel }}">
            {{ navSvg | safe }}
        </button>
    {% endif %}
{% endmacro %}

{% macro mobileNav(prevLabel="", nextLabel="", fraction="1/1", prevHref="", nextHref="", prevDisabled=false, nextDisabled=false) %}
    <div class="mobile-nav">
        {{ navBtn(direction="prev", label=prevLabel, href=prevHref, disabled=prevDisabled) }}
        <div class="fraction" aria-live="polite">{{ fraction }}</div>
        {{ navBtn(direction="next", label=nextLabel, href=nextHref, disabled=nextDisabled) }}
    </div>
{% endmacro %}