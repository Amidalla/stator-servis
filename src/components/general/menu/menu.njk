<div class="menu" data-dropdown="menu">
    <div class="menu-header">
        {{ logo(image="/assets/images/system/logo.svg", alt="Статор-Сервис") }}
        <button class="menu-close" type="button" aria-label="Закрыть меню" data-toggle="menu">
            <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 21 21" fill="none" aria-hidden="true">
                <path
                    d="M20.207 1.41406L11.5166 10.1035L20.2051 18.792L18.791 20.2061L10.1035 11.5176L1.41602 20.2061L0.00195312 18.792L8.68945 10.1035L0 1.41406L1.41406 0L10.1035 8.68945L18.793 0L20.207 1.41406Z"
                    fill="#D64212"
                />
