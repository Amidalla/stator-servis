{% macro render(
        items=[],
        group="",
        variant="pills",
        class="",
        ariaLabel="Фильтр"
    ) %}
    {% set tabsClasses = "tabs " + variant %}
    {% if class %}
        {% set tabsClasses = tabsClasses + " " + class %}
    {% endif %}

    <div
        class="{{ tabsClasses }}"
        role="tablist"
        aria-label="{{ ariaLabel }}"
        {% if group %}data-tabs="{{ group }}"
        {% else %}data-tabs{% endif %}
    >
        {% for item in items %}
            <button
                class="tab{% if item.active %} active{% endif %}"
                type="button"
                role="tab"
                {% if item.id %}id="tab-{{ group }}-{{ item.id }}"{% endif %}
                {% if item.id %}data-tab="{{ item.id }}"{% endif %}
                {% if group %}data-tabs-group="{{ group }}"{% endif %}
                aria-selected="{{ "true" if item.active else "false" }}"
                {% if item.id %}aria-controls="panel-{{ group }}-{{ item.id }}"{% endif %}
            >
                {{ item.title }}
            </button>
        {% endfor %}
    </div>
{% endmacro %}