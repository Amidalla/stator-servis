{% from "components/general/button/button.njk" import render as button %}
{% from "components/general/input/input.njk" import render as input %}
{% from "components/general/textarea/textarea.njk" import render as textarea %}
{% from "components/general/consent-checkbox/consent-checkbox.njk" import render as consentCheckbox %}

<div id="popup-order" class="popup-order">
    <button class="popup-order-close" type="button" aria-label="Закрыть">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="21"
            height="21"
            viewBox="0 0 21 21"
            fill="none"
            aria-hidden="true"
        >
            <path
                d="M20.207 1.41406L11.5166 10.1035L20.2051 18.792L18.791 20.2061L10.1035 11.5176L1.41602 20.2061L0.00195312 18.792L8.68945 10.1035L0 1.41406L1.41406 0L10.1035 8.68945L18.793 0L20.207 1.41406Z"
                fill="#D64212"
            />
        </svg>
    </button>

    <div class="heading">
        <div class="title">Оставить заявку на&nbsp;услугу</div>
        <p class="text">
            Оставьте контакты и&nbsp;опишите задачу&nbsp;— мы&nbsp;уточним детали, стоимость и&nbsp;сроки.
        </p>
    </div>

    <form class="form" data-validate>
        <div class="field">
            <label class="label" for="popup-order-name">Ваше имя</label>
            {{ input(
                type="text",
                id="popup-order-name",
                name="name",
                placeholder="Введите ваше имя",
                autocomplete="name",
                required=true,
                minlength="2",
                data={"error": "Введите имя (минимум 2 буквы)"}
            ) }}
        </div>

        <div class="field">
            <label class="label" for="popup-order-phone">Телефон</label>
            {{ input(
                type="tel",
                id="popup-order-phone",
                name="phone",
                placeholder="+7 (___) ___-__-__",
                autocomplete="tel",
                data={"mask": "phone", "error": "Введите полный номер телефона"},
                required=true
            ) }}
        </div>

        <div class="field">
            <label class="label" for="popup-order-service">Услуга</label>
            {{ input(
                type="text",
                id="popup-order-service",
                name="service",
                class="input-service",
                readonly=true
            ) }}
        </div>

        <div class="field">
            <label class="label" for="popup-order-message">Комментарий</label>
            {{ textarea(
                id="popup-order-message",
                name="message",
                rows="4",
                placeholder="Комментарий"
            ) }}
        </div>

        <div class="field-consent">
            {{ consentCheckbox(
                id="popup-order-consent",
                text="я согласен на обработку моих персональных данных",
                required=true,
                data={"error": "Необходимо отметить"}
            ) }}
        </div>

        <div class="actions">
            {{ button(
                text="Отправить заявку",
                type="submit",
                variant="red",
                disabled=true
            ) }}
        </div>
    </form>
</div>